NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# SQLite data directory and database file
DATA_DIR=./data
# DATABASE_PATH=./data/subhub.db

# Password created on first start when the database has no users
ADMIN_PASSWORD=change-me

SESSION_TTL_DAYS=30
COOKIE_SECURE=false
TRUST_PROXY=false
LOG_LEVEL=info

# Built frontend assets. Docker image uses /app/web.
# WEB_DIST=./apps/web/dist

FETCH_TIMEOUT_MS=30000
# DEFAULT_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1
