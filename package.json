{
  "name": "subhub",
  "private": true,
  "version": "0.0.9",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @subhub/server --filter @subhub/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @subhub/server start",
    "check": "biome check . && pnpm -r typecheck",
    "format": "biome check --write .",
    "test": "pnpm --filter @subhub/proxy-core test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "typescript": "^5.9.3"
  }
}
